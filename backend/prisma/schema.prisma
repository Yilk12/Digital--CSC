generator client {
  provider = "prisma-client-js"
}

// ====================================================================
// WORKFLOW: HR OVERTIME NOTIFICATION MODEL
// ====================================================================

model HrOvertimeNotification {
  id                String   @id @default(uuid()) @db.Uuid
  message           String
  overtimeRequestId String   @db.Uuid
  reqId             String   @db.Uuid // requester id
  actionByUserId    String?  @db.Uuid // who approved/rejected
  departmentId      String?  @db.Uuid
  createdAt         DateTime @default(now())

  // Relations
  overtimeRequest OvertimeRequest @relation(fields: [overtimeRequestId], references: [id])
  requester       User            @relation("HrOvertimeNotificationRequester", fields: [reqId], references: [id])
  actionBy        User?           @relation("HrOvertimeNotificationActionBy", fields: [actionByUserId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])

  @@index([overtimeRequestId])
  @@index([reqId])
  @@index([actionByUserId])
  @@index([departmentId])
}

enum FuelAmountType {
  LITER
  COUPON
  CASH
}

enum FuelStatus {
  FUELED
  NOT_FUELED
  HALF_FUELED
}

model FuelRequest {
  id          String @id @default(uuid()) @db.Uuid
  requestorId String @db.Uuid
  vehicleId   String @db.Uuid

  date                 DateTime
  odometer             Int
  amount               Float
  amountType           FuelAmountType
  notes                String?
  status               FuelStatus     @default(NOT_FUELED)
  returnOdometerKm     Int?
  remainingFuelRequest Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  user    User    @relation(fields: [requestorId], references: [id])
}

// ====================================================================
// WORKFLOW: OVERTIME REQUEST MODEL
// ====================================================================

model OvertimeRequest {
  id           String                @id @default(uuid()) @db.Uuid
  reqId        String                @db.Uuid
  departmentId String?               @db.Uuid
  overtimeType OvertimeType
  durationType OvertimeDurationType
  startTime    DateTime?
  endTime      DateTime?
  dates        DateTime[]
  description  String?
  status       RequestDecisionStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  // Relations
  requestor                User?                      @relation(fields: [reqId], references: [id])
  department               Department?                @relation(fields: [departmentId], references: [id])
  notifications            OvertimeNotification[]
  Vehicle                  Vehicle?                   @relation(fields: [vehicleId], references: [id])
  vehicleId                String?                    @db.Uuid
  HrOvertimeNotification   HrOvertimeNotification[]
  UserOvertimeNotification UserOvertimeNotification[]

  @@index([reqId])
  @@index([departmentId])
}

// ====================================================================
// WORKFLOW: OVERTIME NOTIFICATION MODEL
// ====================================================================

model OvertimeNotification {
  id                String   @id @default(uuid()) @db.Uuid
  message           String
  userId            String   @db.Uuid
  overtimeRequestId String   @db.Uuid
  departmentId      String?  @db.Uuid
  createdAt         DateTime @default(now())

  // Relations
  user            User            @relation(fields: [userId], references: [id])
  overtimeRequest OvertimeRequest @relation(fields: [overtimeRequestId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  Vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  vehicleId       String?         @db.Uuid

  @@index([userId])
  @@index([overtimeRequestId])
  @@index([departmentId])
}

// ====================================================================
// WORKFLOW: USER OVERTIME NOTIFICATION MODEL (per-requester)
// ====================================================================

model UserOvertimeNotification {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid // recipient (request owner)
  message           String
  overtimeRequestId String   @db.Uuid
  departmentId      String?  @db.Uuid
  actionByUserId    String?  @db.Uuid
  createdAt         DateTime @default(now())

  // Relations
  user            User            @relation("UserOvertimeNotificationRecipient", fields: [userId], references: [id])
  actionBy        User?           @relation("UserOvertimeNotificationActionBy", fields: [actionByUserId], references: [id])
  overtimeRequest OvertimeRequest @relation(fields: [overtimeRequestId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@index([overtimeRequestId])
  @@index([departmentId])
  @@index([actionByUserId])
}

// ====================================================================
// WORKFLOW: FIELD NOTIFICATION MODEL
// ====================================================================

model FieldNotification {
  id             String   @id @default(uuid()) @db.Uuid
  message        String
  userId         String   @db.Uuid
  fieldRequestId String   @db.Uuid
  departmentId   String?  @db.Uuid
  createdAt      DateTime @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id])
  fieldRequest FieldRequest @relation(fields: [fieldRequestId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@index([fieldRequestId])
  @@index([departmentId])
}

// ====================================================================
// WORKFLOW: HR NOTIFICATION MODEL
// ====================================================================
model HrNotification {
  id             String   @id @default(uuid()) @db.Uuid
  message        String
  fieldRequestId String   @db.Uuid
  reqId          String   @db.Uuid // requester id
  actionByUserId String?  @db.Uuid // who approved/rejected
  createdAt      DateTime @default(now())

  // Relations
  fieldRequest FieldRequest @relation(fields: [fieldRequestId], references: [id])
  requester    User         @relation("HrNotificationRequester", fields: [reqId], references: [id])
  actionBy     User?        @relation("HrNotificationActionBy", fields: [actionByUserId], references: [id])

  @@index([fieldRequestId])
  @@index([reqId])
  @@index([actionByUserId])
}

// ====================================================================
// USER NOTIFICATION MODEL (Generic per-user notifications)
// ====================================================================
model UserNotification {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  message   String
  status    RequestDecisionStatus?
  isRead    Boolean                @default(false)
  createdAt DateTime               @default(now())

  // Optional linkage to a workflow FieldRequest and Department and the actor
  fieldRequestId String? @db.Uuid
  departmentId   String? @db.Uuid
  actionByUserId String? @db.Uuid

  // Relations
  user         User          @relation("UserNotificationRecipient", fields: [userId], references: [id])
  actionBy     User?         @relation("UserNotificationActionBy", fields: [actionByUserId], references: [id])
  fieldRequest FieldRequest? @relation(fields: [fieldRequestId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@index([fieldRequestId])
  @@index([departmentId])
  @@index([actionByUserId])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

