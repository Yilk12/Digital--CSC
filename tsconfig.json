{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./shared/src/*"]
    }
  },
  "include": [
    "next-env.d.ts", 
    "app/**/*.ts", 
    "app/**/*.tsx", 
    "app/components/**/*.ts", 
    "app/components/**/*.tsx", 
    "app/hooks/**/*.ts", 
    "backend/lib/**/*.ts", 
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "backend", "dist"]
}
